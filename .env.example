# Local Supabase (`npx supabase start` prints these; `npx supabase status` shows them again).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Local Redis (`docker compose up -d`). Upstash later: only this URL changes.
REDIS_URL=redis://127.0.0.1:6379/0

# WhatsApp (Meta Cloud API)
# App secret from the Meta app dashboard: signs every webhook POST.
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Empty = dry run: replies are stored as not_sent, nothing goes to Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Seconds to wait for more messages before answering a burst (§5: 6-8 s).
DEBOUNCE_SECONDS=7

# LLMs via OpenRouter (https://openrouter.ai). The user picks the models.
OPENROUTER_API_KEY=
# e.g. a fast model for reading messages, a stronger one for writing replies
EXTRACTOR_MODEL=
RESPONDER_MODEL=
# Reasoning per role: off (default; fastest) | low | medium | high
EXTRACTOR_REASONING=off
RESPONDER_REASONING=off
