# Local Supabase (`npx supabase start` prints these; `npx supabase status` shows them again).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Local Redis (`docker compose up -d`). In production: Railway's Redis (DEPLOY.md); only this URL changes.
REDIS_URL=redis://127.0.0.1:6379/0

# WhatsApp (Meta Cloud API)
# App secret from the Meta app dashboard: signs every webhook POST.
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Empty = dry run: replies are stored as not_sent, nothing goes to Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Alerts to Trez's agents are business-initiated: outside the 24 hours after an agent last wrote to
# this number, Meta delivers only an approved template. Create one in WhatsApp Manager > Message
# templates: category Utility, language English, body exactly:
#   New lead from the Trez WhatsApp assistant: {{1}}
# ({{1}} gets the whole alert on one line). Put its name here once approved. Empty = alerts go as
# plain text, which reaches an agent only if they messaged this number in the last 24 hours.
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE_LANGUAGE=en
# Seconds to wait for more messages before answering a burst (§5: 6-8 s).
DEBOUNCE_SECONDS=7

# LLMs via OpenRouter (https://openrouter.ai). The user picks the models.
OPENROUTER_API_KEY=
# e.g. a fast model for reading messages, a stronger one for writing replies
EXTRACTOR_MODEL=
RESPONDER_MODEL=
# Reasoning per role: off (default; fastest) | low | medium | high
EXTRACTOR_REASONING=off
RESPONDER_REASONING=off

# Tracing (Langfuse): one trace per buyer turn, one session per buyer. Empty keys = tracing off.
# Langfuse Cloud: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US); keys work only
# on the region they were made in (this project: US). Keys from project settings.
# Local: observability/docker-compose.yml, host http://localhost:3000, keys from observability/.env.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=local

# Errors (Sentry, optional): empty = off. Phone numbers are masked before sending.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
