# Secrets for the local Langfuse stack (observability/docker-compose.yml).
# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
MINIO_PASSWORD=
SALT=
NEXTAUTH_SECRET=
# exactly 64 hex characters
ENCRYPTION_KEY=

# Created on first start. Copy the two keys into the main .env as
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY. The login is for http://localhost:3000.
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=
LANGFUSE_LOGIN_EMAIL=dev@trez.local
LANGFUSE_LOGIN_PASSWORD=
